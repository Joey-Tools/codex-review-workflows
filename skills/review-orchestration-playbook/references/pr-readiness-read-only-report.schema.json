{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joey-tools.invalid/review-orchestration-playbook/pr-readiness-read-only-report.schema.json",
  "title": "PR Readiness Read-Only Probe Terminal Report",
  "type": "object",
  "required": [
    "schema_version",
    "terminal",
    "handoff_profile",
    "delivery_record",
    "target",
    "snapshot",
    "evidence",
    "unavailable_evidence",
    "blockers",
    "actions",
    "merge_ready",
    "next_handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "terminal": {
      "const": "pr-readiness-read-only-report"
    },
    "handoff_profile": {
      "const": "pr-readiness-read-only-probe"
    },
    "delivery_record": {
      "allOf": [
        {
          "$ref": "https://joey-tools.invalid/change-delivery-workflow/delivery-result.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "const": "local-gate"
            },
            "constraints": {
              "contains": {
                "enum": [
                  "report-only",
                  "probe-only",
                  "read-only",
                  "no-remote"
                ]
              }
            },
            "remote_mutation": {
              "const": "forbidden"
            },
            "handoff": {
              "const": "review-orchestration-playbook"
            },
            "handoff_profile": {
              "const": "pr-readiness-read-only-probe"
            }
          },
          "required": [
            "profile",
            "constraints",
            "remote_mutation",
            "handoff",
            "handoff_profile"
          ]
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "evidence": {
      "type": "object",
      "required": [
        "pr_selection",
        "pr_lifecycle",
        "ci_status",
        "conversation_state",
        "base_and_head"
      ],
      "properties": {
        "pr_selection": {
          "$ref": "#/$defs/prSelectionEvidence"
        },
        "pr_lifecycle": {
          "$ref": "#/$defs/prLifecycleEvidence"
        },
        "ci_status": {
          "$ref": "#/$defs/ciStatusEvidence"
        },
        "conversation_state": {
          "$ref": "#/$defs/conversationStateEvidence"
        },
        "base_and_head": {
          "$ref": "#/$defs/baseAndHeadEvidence"
        }
      },
      "additionalProperties": false
    },
    "unavailable_evidence": {
      "type": "array",
      "items": {
        "enum": [
          "pr-selection",
          "pr-lifecycle",
          "ci-status",
          "conversation-state",
          "base-and-head"
        ]
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "code",
          "detail"
        ],
        "properties": {
          "evidence": {
            "enum": [
              "pr-selection",
              "pr-lifecycle",
              "ci-status",
              "conversation-state",
              "base-and-head"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "actions": {
      "type": "object",
      "required": [
        "local_lanes_started",
        "secret_admission_started",
        "comments_posted",
        "waits_started",
        "cache_or_state_written",
        "local_mutation_performed",
        "remote_mutation_performed"
      ],
      "properties": {
        "local_lanes_started": {
          "const": false
        },
        "secret_admission_started": {
          "const": false
        },
        "comments_posted": {
          "const": false
        },
        "waits_started": {
          "const": false
        },
        "cache_or_state_written": {
          "const": false
        },
        "local_mutation_performed": {
          "const": false
        },
        "remote_mutation_performed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "merge_ready": {
      "const": false
    },
    "next_handoff": {
      "const": "none"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/prSelectionConsistency"
    },
    {
      "$ref": "#/$defs/prLifecycleConsistency"
    },
    {
      "$ref": "#/$defs/ciStatusConsistency"
    },
    {
      "$ref": "#/$defs/conversationStateConsistency"
    },
    {
      "$ref": "#/$defs/baseAndHeadConsistency"
    }
  ],
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "repository": {
      "type": "object",
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "binding_id",
        "repository",
        "pull_request",
        "base",
        "head"
      ],
      "properties": {
        "binding_id": {
          "const": "report-target-v1"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "pull_request": {
          "type": "object",
          "required": [
            "number",
            "url"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://\\S+$"
            }
          },
          "additionalProperties": false
        },
        "base": {
          "type": "object",
          "required": [
            "ref",
            "oid"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "oid": {
              "$ref": "#/$defs/oid"
            }
          },
          "additionalProperties": false
        },
        "head": {
          "type": "object",
          "required": [
            "repository",
            "ref",
            "oid"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/repository"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "oid": {
              "$ref": "#/$defs/oid"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "binding_id",
        "snapshot_id",
        "observed_at",
        "freshness",
        "sources"
      ],
      "properties": {
        "binding_id": {
          "const": "report-snapshot-v1"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "freshness": {
          "const": "current"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "github-rest",
              "github-graphql",
              "gh-cli-read-only",
              "local-git-read-only"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "evidenceStatus": {
      "enum": [
        "observed",
        "unavailable",
        "blocked"
      ]
    },
    "prSelectionEvidence": {
      "type": "object",
      "required": [
        "status",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "target_binding": {
          "const": "report-target-v1"
        },
        "snapshot_binding": {
          "const": "report-snapshot-v1"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "selection_method",
              "candidate_count"
            ],
            "properties": {
              "selection_method": {
                "enum": [
                  "explicit",
                  "unique-open-head"
                ]
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "prLifecycleEvidence": {
      "type": "object",
      "required": [
        "status",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "target_binding": {
          "const": "report-target-v1"
        },
        "snapshot_binding": {
          "const": "report-snapshot-v1"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "state",
              "merged",
              "merged_at",
              "draft"
            ],
            "properties": {
              "state": {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "merged": {
                "type": "boolean"
              },
              "merged_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
                  }
                ]
              },
              "draft": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "ciStatusEvidence": {
      "type": "object",
      "required": [
        "status",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "target_binding": {
          "const": "report-target-v1"
        },
        "snapshot_binding": {
          "const": "report-snapshot-v1"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "state",
              "total",
              "successful",
              "failed",
              "pending"
            ],
            "properties": {
              "state": {
                "enum": [
                  "success",
                  "failure",
                  "pending",
                  "cancelled",
                  "no-checks"
                ]
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "successful": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "conversationStateEvidence": {
      "type": "object",
      "required": [
        "status",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "target_binding": {
          "const": "report-target-v1"
        },
        "snapshot_binding": {
          "const": "report-snapshot-v1"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "total_threads",
              "unresolved_threads"
            ],
            "properties": {
              "total_threads": {
                "type": "integer",
                "minimum": 0
              },
              "unresolved_threads": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "baseAndHeadEvidence": {
      "type": "object",
      "required": [
        "status",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "target_binding": {
          "const": "report-target-v1"
        },
        "snapshot_binding": {
          "const": "report-snapshot-v1"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "base_object_present",
              "head_object_present",
              "merge_base_count",
              "merge_base_oid"
            ],
            "properties": {
              "base_object_present": {
                "type": "boolean"
              },
              "head_object_present": {
                "type": "boolean"
              },
              "merge_base_count": {
                "type": "integer",
                "minimum": 0
              },
              "merge_base_oid": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/oid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "nonemptyObservedEvidence": {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "observed": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "observed": {
            "maxItems": 0
          }
        }
      }
    },
    "prSelectionConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "pr_selection": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "pr_selection"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "pr-selection"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/prSelectionBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "pr-selection"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/prSelectionBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "prLifecycleConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "pr_lifecycle": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "pr_lifecycle"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "pr-lifecycle"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/prLifecycleBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "pr-lifecycle"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/prLifecycleBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "ciStatusConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "ci_status": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "ci_status"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "ci-status"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/ciStatusBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "ci-status"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/ciStatusBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "conversationStateConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "conversation_state": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "conversation_state"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "conversation-state"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/conversationStateBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "conversation-state"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/conversationStateBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "baseAndHeadConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "base_and_head": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "base_and_head"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "base-and-head"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/baseAndHeadBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "base-and-head"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/baseAndHeadBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "prSelectionBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "pr-selection"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "prLifecycleBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "pr-lifecycle"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "ciStatusBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "ci-status"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "conversationStateBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "conversation-state"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "baseAndHeadBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "base-and-head"
        }
      },
      "required": [
        "evidence"
      ]
    }
  }
}
