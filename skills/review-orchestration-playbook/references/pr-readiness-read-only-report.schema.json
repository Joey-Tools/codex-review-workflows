{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joey-tools.invalid/review-orchestration-playbook/pr-readiness-read-only-report.schema.json",
  "title": "PR Readiness Read-Only Probe Terminal Report",
  "type": "object",
  "required": [
    "schema_version",
    "terminal",
    "handoff_profile",
    "delivery_record",
    "evidence",
    "unavailable_evidence",
    "blockers",
    "actions",
    "merge_ready",
    "next_handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "terminal": {
      "const": "pr-readiness-read-only-report"
    },
    "handoff_profile": {
      "const": "pr-readiness-read-only-probe"
    },
    "delivery_record": {
      "allOf": [
        {
          "$ref": "https://joey-tools.invalid/change-delivery-workflow/delivery-result.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "const": "local-gate"
            },
            "constraints": {
              "contains": {
                "enum": [
                  "report-only",
                  "probe-only",
                  "read-only",
                  "no-remote"
                ]
              }
            },
            "remote_mutation": {
              "const": "forbidden"
            },
            "formal_review_required": {
              "const": false
            },
            "handoff": {
              "const": "review-orchestration-playbook"
            },
            "handoff_profile": {
              "const": "pr-readiness-read-only-probe"
            }
          },
          "required": [
            "profile",
            "constraints",
            "remote_mutation",
            "formal_review_required",
            "handoff",
            "handoff_profile"
          ]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "pr_selection",
        "pr_lifecycle",
        "ci_status",
        "conversation_state",
        "base_and_head"
      ],
      "properties": {
        "pr_selection": {
          "$ref": "#/$defs/evidenceSnapshot"
        },
        "pr_lifecycle": {
          "$ref": "#/$defs/evidenceSnapshot"
        },
        "ci_status": {
          "$ref": "#/$defs/evidenceSnapshot"
        },
        "conversation_state": {
          "$ref": "#/$defs/evidenceSnapshot"
        },
        "base_and_head": {
          "$ref": "#/$defs/evidenceSnapshot"
        }
      },
      "additionalProperties": false
    },
    "unavailable_evidence": {
      "type": "array",
      "items": {
        "enum": [
          "pr-selection",
          "pr-lifecycle",
          "ci-status",
          "conversation-state",
          "base-and-head"
        ]
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "code",
          "detail"
        ],
        "properties": {
          "evidence": {
            "enum": [
              "pr-selection",
              "pr-lifecycle",
              "ci-status",
              "conversation-state",
              "base-and-head"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "actions": {
      "type": "object",
      "required": [
        "local_lanes_started",
        "secret_admission_started",
        "comments_posted",
        "waits_started",
        "cache_or_state_written",
        "local_mutation_performed",
        "remote_mutation_performed"
      ],
      "properties": {
        "local_lanes_started": {
          "const": false
        },
        "secret_admission_started": {
          "const": false
        },
        "comments_posted": {
          "const": false
        },
        "waits_started": {
          "const": false
        },
        "cache_or_state_written": {
          "const": false
        },
        "local_mutation_performed": {
          "const": false
        },
        "remote_mutation_performed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "merge_ready": {
      "const": false
    },
    "next_handoff": {
      "const": "none"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/prSelectionConsistency"
    },
    {
      "$ref": "#/$defs/prLifecycleConsistency"
    },
    {
      "$ref": "#/$defs/ciStatusConsistency"
    },
    {
      "$ref": "#/$defs/conversationStateConsistency"
    },
    {
      "$ref": "#/$defs/baseAndHeadConsistency"
    }
  ],
  "$defs": {
    "evidenceSnapshot": {
      "type": "object",
      "required": [
        "status",
        "details"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "unavailable",
            "blocked"
          ]
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false
    },
    "prSelectionConsistency": {
      "$comment": "Expanded below because JSON Schema has no parameterized references.",
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "pr_selection": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "pr_selection"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "pr-selection"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/prSelectionBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "pr-selection"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/prSelectionBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "prLifecycleConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "pr_lifecycle": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "pr_lifecycle"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "pr-lifecycle"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/prLifecycleBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "pr-lifecycle"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/prLifecycleBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "ciStatusConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "ci_status": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "ci_status"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "ci-status"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/ciStatusBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "ci-status"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/ciStatusBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "conversationStateConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "conversation_state": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "conversation_state"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "conversation-state"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/conversationStateBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "conversation-state"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/conversationStateBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "baseAndHeadConsistency": {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "base_and_head": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "base_and_head"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "unavailable_evidence": {
            "not": {
              "contains": {
                "const": "base-and-head"
              }
            }
          },
          "blockers": {
            "not": {
              "contains": {
                "$ref": "#/$defs/baseAndHeadBlocker"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_evidence": {
            "contains": {
              "const": "base-and-head"
            }
          },
          "blockers": {
            "contains": {
              "$ref": "#/$defs/baseAndHeadBlocker"
            },
            "maxContains": 1
          }
        }
      }
    },
    "prSelectionBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "pr-selection"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "prLifecycleBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "pr-lifecycle"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "ciStatusBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "ci-status"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "conversationStateBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "conversation-state"
        }
      },
      "required": [
        "evidence"
      ]
    },
    "baseAndHeadBlocker": {
      "type": "object",
      "properties": {
        "evidence": {
          "const": "base-and-head"
        }
      },
      "required": [
        "evidence"
      ]
    }
  }
}
