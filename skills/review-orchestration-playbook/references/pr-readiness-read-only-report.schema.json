{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joey-tools.invalid/review-orchestration-playbook/pr-readiness-read-only-report.schema.json",
  "title": "PR Readiness Read-Only Probe Terminal Report",
  "type": "object",
  "required": [
    "schema_version",
    "terminal",
    "terminal_state",
    "report_id",
    "handoff_profile",
    "delivery_record",
    "target",
    "snapshot",
    "evidence",
    "unavailable_evidence",
    "blockers",
    "actions",
    "merge_ready",
    "next_handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "terminal": {
      "const": "pr-readiness-read-only-report"
    },
    "terminal_state": {
      "enum": [
        "pre-target",
        "pre-target-blocked",
        "target-resolution-blocked",
        "target-snapshot"
      ]
    },
    "report_id": {
      "$ref": "#/$defs/reportId"
    },
    "handoff_profile": {
      "const": "pr-readiness-read-only-probe"
    },
    "delivery_record": {
      "allOf": [
        {
          "$ref": "https://joey-tools.invalid/change-delivery-workflow/delivery-result.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "profile": {
              "const": "local-gate"
            },
            "constraints": {
              "contains": {
                "enum": [
                  "report-only",
                  "probe-only",
                  "read-only",
                  "no-remote"
                ]
              }
            },
            "remote_mutation": {
              "const": "forbidden"
            },
            "handoff": {
              "const": "review-orchestration-playbook"
            },
            "handoff_profile": {
              "const": "pr-readiness-read-only-probe"
            }
          },
          "required": [
            "profile",
            "constraints",
            "remote_mutation",
            "handoff",
            "handoff_profile"
          ]
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "evidence": {
      "type": "object",
      "required": [
        "pr_selection",
        "pr_lifecycle",
        "ci_status",
        "conversation_state",
        "base_and_head"
      ],
      "properties": {
        "pr_selection": {
          "$ref": "#/$defs/prSelectionEvidence"
        },
        "pr_lifecycle": {
          "$ref": "#/$defs/prLifecycleEvidence"
        },
        "ci_status": {
          "$ref": "#/$defs/ciStatusEvidence"
        },
        "conversation_state": {
          "$ref": "#/$defs/conversationStateEvidence"
        },
        "base_and_head": {
          "$ref": "#/$defs/baseAndHeadEvidence"
        }
      },
      "additionalProperties": false
    },
    "unavailable_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceName"
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "code",
          "detail"
        ],
        "properties": {
          "evidence": {
            "$ref": "#/$defs/evidenceName"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "actions": {
      "type": "object",
      "required": [
        "local_lanes_started",
        "secret_admission_started",
        "comments_posted",
        "waits_started",
        "cache_or_state_written",
        "local_mutation_performed",
        "remote_mutation_performed"
      ],
      "properties": {
        "local_lanes_started": {
          "const": false
        },
        "secret_admission_started": {
          "const": false
        },
        "comments_posted": {
          "const": false
        },
        "waits_started": {
          "const": false
        },
        "cache_or_state_written": {
          "const": false
        },
        "local_mutation_performed": {
          "const": false
        },
        "remote_mutation_performed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "merge_ready": {
      "const": false
    },
    "next_handoff": {
      "const": "none"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/terminalStateConsistency"
    },
    {
      "$ref": "#/$defs/observedSourceConsistency"
    },
    {
      "$ref": "#/$defs/prSelectionConsistency"
    },
    {
      "$ref": "#/$defs/prLifecycleConsistency"
    },
    {
      "$ref": "#/$defs/ciStatusConsistency"
    },
    {
      "$ref": "#/$defs/conversationStateConsistency"
    },
    {
      "$ref": "#/$defs/baseAndHeadConsistency"
    }
  ],
  "$defs": {
    "reportId": {
      "type": "string",
      "pattern": "^report:[0-9a-f]{32}$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^target:[0-9a-f]{32}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot:[0-9a-f]{32}$"
    },
    "observationId": {
      "type": "string",
      "pattern": "^observation:[0-9a-f]{32}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "evidenceName": {
      "enum": [
        "pr-selection",
        "pr-lifecycle",
        "ci-status",
        "conversation-state",
        "base-and-head"
      ]
    },
    "evidenceStatus": {
      "enum": [
        "observed",
        "unavailable",
        "blocked"
      ]
    },
    "nonObservedStatus": {
      "enum": [
        "unavailable",
        "blocked"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "pullRequest": {
      "type": "object",
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://\\S+$"
        }
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": [
        "ref",
        "oid"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "oid": {
          "$ref": "#/$defs/oid"
        }
      },
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "oid"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "oid": {
          "$ref": "#/$defs/oid"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "report_binding",
        "binding_id",
        "state",
        "repository"
      ],
      "properties": {
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "binding_id": {
          "$ref": "#/$defs/targetId"
        },
        "state": {
          "enum": [
            "pre-target",
            "pr-selected",
            "range-resolved"
          ]
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "pull_request": {
          "$ref": "#/$defs/pullRequest"
        },
        "base": {
          "$ref": "#/$defs/base"
        },
        "head": {
          "$ref": "#/$defs/head"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "pre-target"
            }
          },
          "required": [
            "state"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "pull_request"
                ]
              },
              {
                "required": [
                  "base"
                ]
              },
              {
                "required": [
                  "head"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "state": {
              "const": "pr-selected"
            }
          },
          "required": [
            "state",
            "pull_request"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "base"
                ]
              },
              {
                "required": [
                  "head"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "state": {
              "const": "range-resolved"
            }
          },
          "required": [
            "state",
            "pull_request",
            "base",
            "head"
          ]
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "required": [
        "report_binding",
        "target_binding",
        "binding_id",
        "snapshot_id",
        "observed_at",
        "freshness",
        "sources"
      ],
      "properties": {
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "binding_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "snapshot_id": {
          "$ref": "#/$defs/observationId"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "freshness": {
          "const": "current"
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "github-rest",
              "github-graphql",
              "gh-cli-read-only",
              "local-git-read-only"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "prSelectionEvidence": {
      "type": "object",
      "required": [
        "status",
        "report_binding",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "snapshot_binding": {
          "$ref": "#/$defs/snapshotId"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "selection_method",
              "outcome",
              "candidate_count"
            ],
            "properties": {
              "selection_method": {
                "enum": [
                  "explicit",
                  "unique-open-head"
                ]
              },
              "outcome": {
                "enum": [
                  "selected",
                  "no-match",
                  "ambiguous"
                ]
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "outcome": {
                    "const": "selected"
                  },
                  "candidate_count": {
                    "const": 1
                  }
                }
              },
              {
                "properties": {
                  "outcome": {
                    "const": "no-match"
                  },
                  "candidate_count": {
                    "const": 0
                  }
                }
              },
              {
                "properties": {
                  "selection_method": {
                    "const": "unique-open-head"
                  },
                  "outcome": {
                    "const": "ambiguous"
                  },
                  "candidate_count": {
                    "minimum": 2
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "prLifecycleEvidence": {
      "type": "object",
      "required": [
        "status",
        "report_binding",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "snapshot_binding": {
          "$ref": "#/$defs/snapshotId"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "state",
              "merged",
              "merged_at",
              "draft"
            ],
            "properties": {
              "state": {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "merged": {
                "type": "boolean"
              },
              "merged_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/timestamp"
                  }
                ]
              },
              "draft": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "const": "open"
                  },
                  "merged": {
                    "const": false
                  },
                  "merged_at": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "closed"
                  },
                  "merged": {
                    "const": false
                  },
                  "merged_at": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "closed"
                  },
                  "merged": {
                    "const": true
                  },
                  "merged_at": {
                    "$ref": "#/$defs/timestamp"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "ciStatusEvidence": {
      "type": "object",
      "required": [
        "status",
        "report_binding",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "snapshot_binding": {
          "$ref": "#/$defs/snapshotId"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "state",
              "total",
              "successful",
              "failed",
              "pending",
              "cancelled",
              "checks"
            ],
            "properties": {
              "state": {
                "enum": [
                  "success",
                  "failure",
                  "pending",
                  "cancelled",
                  "no-checks"
                ]
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "successful": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "cancelled": {
                "type": "integer",
                "minimum": 0
              },
              "checks": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "conclusion"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "conclusion": {
                      "enum": [
                        "success",
                        "failure",
                        "pending",
                        "cancelled"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "const": "no-checks"
                  },
                  "total": {
                    "const": 0
                  },
                  "successful": {
                    "const": 0
                  },
                  "failed": {
                    "const": 0
                  },
                  "pending": {
                    "const": 0
                  },
                  "cancelled": {
                    "const": 0
                  },
                  "checks": {
                    "maxItems": 0
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "success"
                  },
                  "successful": {
                    "minimum": 1
                  },
                  "failed": {
                    "const": 0
                  },
                  "pending": {
                    "const": 0
                  },
                  "cancelled": {
                    "const": 0
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "failure"
                  },
                  "failed": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "pending"
                  },
                  "failed": {
                    "const": 0
                  },
                  "pending": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "cancelled"
                  },
                  "failed": {
                    "const": 0
                  },
                  "pending": {
                    "const": 0
                  },
                  "cancelled": {
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "conversationStateEvidence": {
      "type": "object",
      "required": [
        "status",
        "report_binding",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "snapshot_binding": {
          "$ref": "#/$defs/snapshotId"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "total_threads",
              "unresolved_threads"
            ],
            "properties": {
              "total_threads": {
                "type": "integer",
                "minimum": 0
              },
              "unresolved_threads": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "baseAndHeadEvidence": {
      "type": "object",
      "required": [
        "status",
        "report_binding",
        "target_binding",
        "snapshot_binding",
        "observed"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "report_binding": {
          "$ref": "#/$defs/reportId"
        },
        "target_binding": {
          "$ref": "#/$defs/targetId"
        },
        "snapshot_binding": {
          "$ref": "#/$defs/snapshotId"
        },
        "observed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "base_object_present",
              "head_object_present",
              "merge_base_count",
              "merge_base_oid"
            ],
            "properties": {
              "base_object_present": {
                "type": "boolean"
              },
              "head_object_present": {
                "type": "boolean"
              },
              "merge_base_count": {
                "type": "integer",
                "minimum": 0
              },
              "merge_base_oid": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/oid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "base_object_present": {
                    "const": false
                  },
                  "merge_base_count": {
                    "const": 0
                  },
                  "merge_base_oid": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "base_object_present": {
                    "const": true
                  },
                  "head_object_present": {
                    "const": false
                  },
                  "merge_base_count": {
                    "const": 0
                  },
                  "merge_base_oid": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "base_object_present": {
                    "const": true
                  },
                  "head_object_present": {
                    "const": true
                  },
                  "merge_base_count": {
                    "const": 0
                  },
                  "merge_base_oid": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "base_object_present": {
                    "const": true
                  },
                  "head_object_present": {
                    "const": true
                  },
                  "merge_base_count": {
                    "const": 1
                  },
                  "merge_base_oid": {
                    "$ref": "#/$defs/oid"
                  }
                }
              },
              {
                "properties": {
                  "base_object_present": {
                    "const": true
                  },
                  "head_object_present": {
                    "const": true
                  },
                  "merge_base_count": {
                    "minimum": 2
                  },
                  "merge_base_oid": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/nonemptyObservedEvidence"
        }
      ]
    },
    "nonemptyObservedEvidence": {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        },
        "required": [
          "status"
        ]
      },
